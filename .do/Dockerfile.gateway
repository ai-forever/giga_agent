# DigitalOcean App Platform: Gateway container
# Co-locates nginx (frontend static + reverse proxy), REPL, and upload-server
# Build context: repo root (source_dir: /)

# Stage 1: Build frontend React app
FROM node:22.12.0-alpine AS frontend-builder
WORKDIR /app

COPY front/package.json front/package-lock.json ./
RUN npm ci

ARG VITE_LANGCONNECT_API_URL
ARG VITE_LANGCONNECT_API_SECRET_TOKEN
ARG VITE_MCP_PROXY_URL
ARG VITE_MEMORY_ENABLED
ENV VITE_LANGCONNECT_API_URL=$VITE_LANGCONNECT_API_URL
ENV VITE_LANGCONNECT_API_SECRET_TOKEN=$VITE_LANGCONNECT_API_SECRET_TOKEN
ENV VITE_MCP_PROXY_URL=$VITE_MCP_PROXY_URL
ENV VITE_MEMORY_ENABLED=$VITE_MEMORY_ENABLED

COPY front/ .
RUN npm run build

# Stage 2: Runtime - Python 3.11 + nginx + supervisord + repl + upload-server + frontend dist
FROM python:3.11

USER root

ENV PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends nginx supervisor curl ca-certificates

RUN curl -fsSL https://deb.nodesource.com/setup_lts.x | bash - \
    && apt-get install -y nodejs \
    && npm install -g npm@latest

COPY backend/repl/pyproject.toml /pyproject.toml
COPY backend/repl/uv.lock /uv.lock

ADD https://astral.sh/uv/install.sh /uv-installer.sh
RUN sh /uv-installer.sh && rm /uv-installer.sh
RUN mv /root/.local/bin/uv /usr/local/bin/uv
ENV PATH="/usr/local/bin:$PATH"

RUN uv sync --locked

COPY backend/repl/app/ /app/
RUN touch /__init__.py

RUN mkdir -p /mnt/ /files /runs /kernel_states /home/jupyter /db
RUN useradd -ms /bin/bash jupyter \
    && chown -R jupyter:jupyter /mnt/ /home/jupyter/ /files /runs /kernel_states /db \
    && chmod -R 777 /mnt/ /home/jupyter/ /files /runs /kernel_states /db

ENV UV_CACHE_DIR=/var/cache/uv
RUN mkdir -p /var/cache/uv \
    && chown -R jupyter:jupyter /var/cache/uv \
    && chown -R jupyter:jupyter /.venv

COPY backend/repl/files/ /files/

COPY --from=frontend-builder /app/dist /usr/share/nginx/html

COPY .do/nginx.do.conf /etc/nginx/conf.d/default.conf
COPY .do/supervisord.conf /etc/supervisor/conf.d/gateway.conf

RUN rm -f /etc/nginx/sites-enabled/default

EXPOSE 80

CMD ["supervisord", "-n", "-c", "/etc/supervisor/conf.d/gateway.conf"]
