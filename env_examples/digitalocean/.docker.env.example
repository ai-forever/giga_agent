# DigitalOcean App Platform environment variables
# NOTE: On DO App Platform, set these as app-level or component-level env vars.
# Encrypt all secrets (API keys, credentials, tokens).
# DATABASE_URL and REDIS_URI are provided by DO managed resources via bindable vars.

# GIGA_AGENT SETTINGS
GIGA_AGENT_LLM=gigachat:GigaChat-2-Max
GIGA_AGENT_LLM_FAST=gigachat:GigaChat-2-Pro
GIGA_AGENT_EMBEDDINGS=gigachat:EmbeddingsGigaR
GIGA_AGENT_SENTIMENT_MODEL=models/sentiment_gigachat.joblib
GIGA_AGENT_LANG=ru-RU
GIGA_AGENT_MCP_CONFIG='{}'
GIGA_AGENT_USER_NOTES=""
GIGA_AGENT_MEMORY_ENABLED=1

# REQUIRED GIGACHAT SETTINGS
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=
GIGACHAT_VERIFY_SSL_CERTS=0
GIGACHAT_TIMEOUT=60
MAIN_GIGACHAT_CREDENTIALS=
MAIN_GIGACHAT_SCOPE=
MAIN_GIGACHAT_TIMEOUT=15
MAIN_GIGACHAT_TOP_P=0.5

# GIGACHAT API (IMAGE GENERATION)
IMAGE_GEN_NAME=gigachat:kandinsky-4.1
IMAGE_GEN_PARALLEL=5

# FOR ENABLING RAG
# LANGCONNECT_API_URL=
# LANGCONNECT_API_SECRET_TOKEN=

# FUSION BRAIN (IMAGE GENERATION)
# IMAGE_GEN_NAME=fusion_brain:123
# KANDINSKY_API_KEY=
# KANDINSKY_SECRET_KEY=

## SERVICES
TAVILY_API_KEY=
VK_TOKEN=
GITHUB_PERSONAL_ACCESS_TOKEN=
OWM_API_KEY=

TWOGIS_TOKEN=

SALUTE_SPEECH=
SBER_TTS_TIMEOUT=30

## INTERNAL STUFF (DO App Platform service names)
PLOTLY_RENDERER=plotly_mimetype
MAX_KERNEL_LIVE=300
FILES_DIR=/files
RUNS_DIR=/runs
LANGGRAPH_API_URL=http://langgraph-api:8000/
JUPYTER_CLIENT_API=http://gateway:9090
JUPYTER_UPLOAD_API=http://gateway:9092
TOOL_CLIENT_API=http://tool-server:9091
GIGA_AGENT_API=http://tasks-api:8822
JINA_READER_URL=https://r.jina.ai/

# After that limit tool response is trimming and saves to REPL var
CHARACTER_LIMIT=100000
# Tries to get code for code_interpreter from message NOT from tool_call arguments
REPL_FROM_MESSAGE=0

# DO MANAGED RESOURCES (use bindable variables in app spec)
# DATABASE_URL=${db.DATABASE_URL}  -- set in app spec, not here
# REDIS_URI=${cache.REDIS_URL}     -- set in app spec, not here
AUTH_TYPE=noop
