# GIGA_AGENT SETTINGS
GIGA_AGENT_LLM=openai:gpt-4o
GIGA_AGENT_LLM_FAST=openai:gpt-4o-mini
GIGA_AGENT_EMBEDDINGS=openai:text-embedding-3-small
GIGA_AGENT_SENTIMENT_MODEL=models/sentiment_openai.joblib
GIGA_AGENT_LANG=en-US
GIGA_AGENT_MCP_CONFIG='{}'
GIGA_AGENT_USER_NOTES=""
GIGA_AGENT_MEMORY_ENABLED=1

# IMAGE GENRERATION SETTINGS
IMAGE_GEN_NAME=openai:dall-e-2
IMAGE_GEN_PARALLEL=5

# FOR ENABLING RAG
# LANGCONNECT_API_URL=
# LANGCONNECT_API_SECRET_TOKEN=

# REQUIRED OPENAI SETTINGS
OPENAI_API_KEY=

## SERVICES
TAVILY_API_KEY=
VK_TOKEN=
GITHUB_PERSONAL_ACCESS_TOKEN=
OWM_API_KEY=

# FUSION BRAIN (IMAGE GENERATION)
KANDINSKY_API_KEY=
KANDINSKY_SECRET_KEY=

TWOGIS_TOKEN=

SALUTE_SPEECH=
SBER_TTS_TIMEOUT=30

## INTERNAL STUFF
PLOTLY_RENDERER=plotly_mimetype
MAX_KERNEL_LIVE=300
FILES_DIR=/files
RUNS_DIR=/runs
LANGGRAPH_API_URL="http://langgraph-api:8000/"
JINA_READER_URL=https://r.jina.ai/

# After that limit tool response is trimming and saves to REPL var
CHARACTER_LIMIT=100000
# Tries to get code for code_interpreter from message NOT from tool_call arguments
REPL_FROM_MESSAGE=0
