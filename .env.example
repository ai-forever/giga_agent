# Секретный ключ обязательно
GIGA_AGENT_SECRET_KEY=""
# Путь до репозитория (в репозитории нужно выполнить pwd и вставить путь)
# Нужно для работы local docker
GIGA_AGENT_HOST_PROJECT_PATH=""

# Путь где принимаются traces
# PHOENIX_COLLECTOR_ENDPOINT="http://host.docker.internal:4318/v1/traces"
# PHOENIX_API_KEY=""
# OTEL_TARGETS="PHOENIX"

# Экспериментальный режим: граф-обёртка giga_agent_experimental (статусы +
# переписывание ответов моделью). Требует GIGACHAT_* креды в env.
# GIGA_AGENT_EXPERIMENTAL_MODE="True"
# GIGA_AGENT_EXPERIMENTAL_REWRITE_MODEL="GigaChat-3-Ultra"
# GIGA_AGENT_EXPERIMENTAL_STATUS_MODEL="GigaChat-3-Pro"

# Кросс-доменный режим открытых портов песочницы (local_docker).
# Когда приложение и песочницы на РАЗНЫХ доменах: open_port отдаёт чистую
# ссылку на домене приложения (GIGA_AGENT_BASE_URL), а бэкенд редиректит на
# https://{port}-sandbox-{hex}.{GIGA_AGENT_SANDBOX_PORT_REDIRECT_BASE}/?__sbx=<token>.
# Требует также GIGA_AGENT_DOCKER_NETWORK. Присутствие REDIRECT_BASE включает режим.
# GIGA_AGENT_BASE_URL="https://agent.giga.chat/app"
# GIGA_AGENT_SANDBOX_PORT_REDIRECT_BASE="gigapp.ru"
# Домен для сессионной куки приложения в кросс-доменном режиме. Пусто -> host-only
# кука на домене приложения (обычно то, что нужно).
# GIGA_AGENT_APP_COOKIE_DOMAIN=""